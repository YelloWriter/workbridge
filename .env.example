# 이 파일을 복사해서 .env.local 로 만들고 값을 채워 주세요. (.env.local 은 절대 커밋하지 않습니다)

# --- 브라우저에 공개돼도 되는 값 (NEXT_PUBLIC_) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TOSS_CLIENT_KEY=          # 토스페이먼츠 "테스트" 클라이언트 키 (test_ck_...)

# --- 서버 전용 값 (절대 NEXT_PUBLIC_ 붙이지 않기) ---
SUPABASE_SERVICE_ROLE_KEY=
TOSS_SECRET_KEY=                      # 토스페이먼츠 "테스트" 시크릿 키 (test_sk_...)
OPENAI_API_KEY=                       # AI 단가 분석용. 다른 Provider를 쓰면 이름을 바꾸고 docs/decisions에 기록
